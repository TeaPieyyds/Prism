        "ID_Camera": [
            {match: include("start")+keywordsToRegex(
                "minecraft:first_person minecraft:third_person minecraft:third_person_front minecraft:free"
            )+include("end") 0: "ID"}
            {match: include("start")+/(/+include("AnyString")+/)/+include("end") 1: "ID2"}
        ]
        "ID_Ease": [
