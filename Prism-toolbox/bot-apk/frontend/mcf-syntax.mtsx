// require MT >= 2.16.0
//========================================================================================//
                    // 名称：指令语法高亮，版本：v3.0.12，作者：胧（356134208）
        // 使用方法：在MT管理器内点击这个文件，选择安装     卸载：点击文件，选择管理，长按文件名卸载
            // 语法高亮只有暗色模式（待更新），    颜色可以在下面自己改，     有bug可以报
       // 由于MT限制原因，在2.16.0以下无层数限制，2.16.0~2.16.1：100，2.16.2:500，2.16.3：1000
                  // 版本号1.0.0以下为一代，1.0.1到2.0.0为二代，3.0.0以上为三代
                    // 一代无版本要求，二代要求2.15.3以上，三代要求2.16.0以上
                      // 语法高亮更新群：（549528248）--包括其他的一些东西
//========================================================================================//
{
    name: ["语法高亮3.0", ".mcfunction"]
    hide: false
    ignoreCase: true
    bracketPairs: ["{}", "[]"]
    styles: [
    //原版颜色
        "§0", #000000, #000000
        "§1", #0000AA, #0000AA
        "§2", #00AA00, #00AA00
        "§3", #00AAAA, #00AAAA
        "§4", #AA0000, #AA0000
        "§5", #AA00AA, #AA00AA
        "§6", #FFAA00, #FFAA00
        "§7", #AAAAAA, #AAAAAA
        "§8", #555555, #555555
        "§9", #5555FF, #5555FF
        "§a", #55FF55, #55FF55
        "§b", #55FFFF, #55FFFF
        "§c", #FF5555, #FF5555
        "§d", #FF55FF, #FF55FF
        "§e", #FFFF55, #FFFF55
        "§f", #FFFFFF, #FFFFFF
        "§g", #DDD605, #DDD605
        "§h", #E3D4D1, #E3D4D1
        "§i", #CECACA, #CECACA
        "§j", #443A3B, #443A3B
        "§l", @B
        "§m", #971607, #971607
        "§n", #B4684D, #B4684D
        "§o", @I
        "§p", #DEB12D, #DEB12D
        "§q", #47A036, #47A036
        "§r" > "string"
        "§s", #2CBAA8, #2CBAA8
        "§t", #21497B, #21497B
        "§u", #9A5CC6, #9A5CC6
        
        //字符串
        "String" > "string"
        //数字
        "Number" > "number"
        //报错
        "Error", #330000$ff00, #AAF50000$0500, @UB
        //转义符
        "Escape", #99CC7832, #99CC7832, @I
        //指令
        "Command", #CC7832, #CC7832, @B
        //子命令
        "Sub", #BBB529, #BBB529
        //游戏ID
        "ID", #9876AA, #9876AA
        "ID2", #707070, #707070, @IU
        //选择器
        "Sele", #E8BF6A, #E8BF6A
        //选择器内的
        "SeleSub", #FFA0F0, #EFDD8A
        //子命令内的
        "Opt", #BB3080, #BB3080
        //json
        "Json-Sym", #7050A0, #7050A0
        "Json-Key", #73BDDB, #73BDDB
        "Json-String", #C17F50, #A17F50
        "Json-Number", #9EBD81, #9EBD81
        "Json-Enum", #2A65AB, #2A65AB
    ]
    comment: {startsWith: "#"}
    defines: [
        "SplitSymbol": /\n ,@~\^\$&"\!#%\+\*\/=\[\]\{\}\|<>`/
        "start": / *(?<=(?:(?:\^|~)(?:[-+]?(?:[0-9]{0,10}\.[0-9]{1,10}|[0-9]{1,10}\.[0-9]{0,10}|[0-9]{1,10})))|[/+include("SplitSymbol")+/]|^)/
        "end": /(?=[/+include("SplitSymbol")+/]|$)/
        "start2": / *(?<=[/+include("SplitSymbol")+/\.])/
        "end2": /(?=[/+include("SplitSymbol")+/\.])/
        "Int": /[-+]?[0-9]{1,}/
        "Float": /[-+]?(?:[0-9]{0,}\.[0-9]{1,}|[0-9]{1,}\.[0-9]{0,}|[0-9]{1,})/
        "Relative_Offset_Float": /~(?:/+include("Float")+/)?/
        "Local_Offset_Float": /\^(?:/+include("Float")+/)?/
        "AnyString": /[^/+include("SplitSymbol")+/]+/
        "AnyMsg": {match:include ("start")+/[^\n]+/, 0: "String"}
        "End_Stop": {match: / *([\S ]*)/ 1: "Error"}
        "stop": {match: include("end") 0: "None"}
        "Error": {match: /.+|\n/ 0: "Error"}
        "StringColor2":{match: /\S/ 0: "error"}
        "StringColor":[
            {match:/§0(.*)/, 0: "§0", 1: {include:"StringColor"}}
            {match:/§1(.*)/, 0: "§1", 1: {include:"StringColor"}}
            {match:/§2(.*)/, 0: "§2", 1: {include:"StringColor"}}
            {match:/§3(.*)/, 0: "§3", 1: {include:"StringColor"}}
            {match:/§4(.*)/, 0: "§4", 1: {include:"StringColor"}}
            {match:/§5(.*)/, 0: "§5", 1: {include:"StringColor"}}
            {match:/§6(.*)/, 0: "§6", 1: {include:"StringColor"}}
            {match:/§7(.*)/, 0: "§7", 1: {include:"StringColor"}}
            {match:/§8(.*)/, 0: "§8", 1: {include:"StringColor"}}
            {match:/§9(.*)/, 0: "§9", 1: {include:"StringColor"}}
            {match:/§a(.*)/, 0: "§a", 1: {include:"StringColor"}}
            {match:/§b(.*)/, 0: "§b", 1: {include:"StringColor"}}
            {match:/§c(.*)/, 0: "§c", 1: {include:"StringColor"}}
            {match:/§d(.*)/, 0: "§d", 1: {include:"StringColor"}}
            {match:/§e(.*)/, 0: "§e", 1: {include:"StringColor"}}
            {match:/§f(.*)/, 0: "§f", 1: {include:"StringColor"}}
            {match:/§g(.*)/, 0: "§g", 1: {include:"StringColor"}}
            {match:/§h(.*)/, 0: "§h", 1: {include:"StringColor"}}
            {match:/§i(.*)/, 0: "§i", 1: {include:"StringColor"}}
            {match:/§j(.*)/, 0: "§j", 1: {include:"StringColor"}}
            {match:/§l(.*)/, 0: "§l", 1: {include:"StringColor"}}
            {match:/§m(.*)/, 0: "§m", 1: {include:"StringColor"}}
            {match:/§n(.*)/, 0: "§n", 1: {include:"StringColor"}}
            {match:/§o(.*)/, 0: "§o", 1: {include:"StringColor"}}
            {match:/§p(.*)/, 0: "§p", 1: {include:"StringColor"}}
            {match:/§q(.*)/, 0: "§q", 1: {include:"StringColor"}}
            {match:/§r(.*)/, 0: "!!§r"1: {include:"StringColor"}}
            {match:/§s(.*)/, 0: "§s", 1: {include:"StringColor"}}
            {match:/§t(.*)/, 0: "§t", 1: {include:"StringColor"}}
            {match:/§u(.*)/, 0: "§u", 1: {include:"StringColor"}}
        ]
        "BE_String":
            {match: include("start")+/([^/+include("SplitSymbol")+/]*)/+include("end")
                1: {match: /\\./ 0: "Escape"}
                1: {include:"StringColor"}
                1: {match: /\S/ 0: "String"}
            }
        "BE_Quotation_String":
            {match: / *"((?:\\"|[^"])*)"/ 0: "String"
                1: {match: /\\./ 0: "Escape"}
                1: {include:"StringColor"}
            }
        "BE_String-ID":
            {start:{match:include("start")+/(?!\.|[0-9])(?<!/+include("end")+/)/}end:{match:include("end")}contains: [
            {match: /[^/+include("SplitSymbol")+/]/ 0: "ID"}]}
        "BE_Quotation_String-ID":
            {start:{match:/ *"/}end:{match:/"/}style:"ID"contains: [
            {match: /\\./ 0: "Escape"}]}
        "Translate_BE_Quotation_String":
            {match: / *"((?:\\"|[^"])*)"/ 0: "String"
                1: {match: /%%[0-9sd](?:\$[sd])?/ 0: "Escape"}
                1: {match: /\\./ 0: "Escape"}
                1: {include:"StringColor"}
            }
        "String_Tree":[
            {include: "BE_Quotation_String"}
            {include: "BE_String"}]
        "String_Tree-ID":[
            {include: "BE_Quotation_String-ID"}
            {include: "BE_String-ID"}]
        "Scoreboard_Entity_Name_Tree": [
            {match: / *\*/ 0: "Sele"}
            {include: "BE_Selector_Tree"}]
        "Json_Scoreboard_Entity_Name_Tree": [
            {match: / *\*/ 0: "Sele"}
            {include: "Json_BE_Selector_Tree"}]
        "Rotation_Tree": [
            {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                {include:"stop"}]}]}
                {group:link,contains:[{match:include("start")+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                {include:"stop"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:include("start")+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                {include:"stop"}]}]}
                {group:link,contains:[{match:include("start")+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                {include:"stop"}]}]}
            {include:"Error"}]}]}
        ]
        "Pos_Tree": [
            {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                    {group:link,contains:[{match:/ */+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                {include:"Error"}]}]}
                {group:link,contains:[{match:/ */+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                    {group:link,contains:[{match:/ */+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:/ */+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                    {group:link,contains:[{match:/ */+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                {include:"Error"}]}]}
                {group:link,contains:[{match:/ */+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                    {group:link,contains:[{match:/ */+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:include("start")+include("Local_Offset_Float"), 0: "Number"}{group:select,contains:[
                {group:link,contains:[{match:include("start")+include("Local_Offset_Float"), 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Local_Offset_Float"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
        ]
        "Range_Tree": [
            {group:link,contains:[{match:/ *!/, 0: "Number"}{group:select,contains:[
                {group:link,contains:[{match:include("start2")+include("Int")+include("end2"), 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:/ *\.\./, 0: "Number"}{group:select,contains:[
                        {group:link,contains:[{match:include("start2")+include("Int")+include("end"), 0: "Number"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"stop"}]}]}
                {include:"stop"}]}]}
                {group:link,contains:[{match:include("start2")+include("Int")+include("end2"), 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:/ *\.\./, 0: "Number"}{group:select,contains:[
                        {group:link,contains:[{match:include("start2")+include("Int")+include("end2"), 0: "Number"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"stop"}]}]}
                {include:"stop"}]}]}
                {group:link,contains:[{match:/ *\.\./, 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:include("start2")+include("Int")+include("end2"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                {include:"stop"}]}]}
            {include:"stop"}]}]}
            {group:link,contains:[{match:include("start2")+include("Int")+include("end2"), 0: "Number"}{group:select,contains:[
                {group:link,contains:[{match:/ *\.\./, 0: "Number"}{group:select,contains:[
                    {group:link,contains:[{match:include("start2")+include("Int")+include("end2"), 0: "Number"}{group:select,contains:[
                    {include:"stop"}]}]}
                {include:"stop"}]}]}
            {include:"stop"}]}]}
            {group:link,contains:[{match:/ *\.\./, 0: "Number"}{group:select,contains:[
                {group:link,contains:[{match:include("start2")+include("Int")+include("end2"), 0: "Number"}{group:select,contains:[
                {include:"stop"}]}]}
            {include:"stop"}]}]}
        ]
        "BE_BlockState_Tree": [
            {group:link,contains:[{match:include("start")+include("Int")+include("end"), 0: "Number"}{group:select,contains:[
            {include:"stop"}]}]}
            {group:link,contains:[{match:/ *\[/, 0: "ID"}{group:select,contains:[
                {include: "BlockStatesKeyValue"}
            {include:"Error"}]}]}
        ]
        "BlockStatesKeyValue": [
            {group:link,contains:[{include:"BE_Quotation_String-ID"}{group:select,contains:[
                {group:link,contains:[{match:/ *(:|=)/, 0: "ID"}{group:select,contains:[
                    {group:link,contains:[{include:"BE_Quotation_String-ID"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "ID"}{group:select,contains:[
                            {include:"BlockStatesKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *]/, 0: "ID"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                    {group:link,contains:[{match: include("Int") 0: "Number"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "ID"}{group:select,contains:[
                            {include:"BlockStatesKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *]/, 0: "ID"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                    {group:link,contains:[{match:include("start")+/(?:false|true)/+include("end"), 0: "Opt"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "ID"}{group:select,contains:[
                            {include:"BlockStatesKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *]/, 0: "ID"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:/ *]/, 0: "ID"}{group:select,contains:[
            {include:"stop"}]}]}
        ]
        "BE_Selector_Tree": [
            {group:link,contains:[{match:/ *@([parse]|initiator)/+include("end"), 0: "Sele"}{group:select,contains:[
                {group:link,contains:[{match:/ *\[/ 0: "Sele"}{group:select,contains:[
                    {include: "SeleKeyValue"}
                {include:"Error"}]}]}
            {include:"stop"}]}]}
            {start:{match:/ *"/}end:{match:/"/}style:"Sele"contains: [
            {match: /\\./ 0: "Escape"}]}
            {start:{match:include("start")+/(?<!/+include("end")+/)/}end:{match:include("end")}contains: [
            {match: include("start")+include("Float") 0: "Error"} => Fail
            {match: /[^/+include("SplitSymbol")+/]/ 0: "Sele"}]}
        ]
        "Json_BE_Selector_Tree": [
            {group:link,contains:[{match:/ *@([parse]|initiator)/+include("end"), 0: "Sele"}{group:select,contains:[
                {group:link,contains:[{match:/ *\[/ 0: "Sele"}{group:select,contains:[
                    {include: "SeleKeyValue"}
                {include:"Error"}]}]}
            {include:"stop"}]}]}
            {start:{match:/ *\\"/}end:{match:/\\"/}style:"Sele"contains: [
            {match: /\\\\\\./ 0: "Escape"}]}
            {start:{match:include("start")+/(?<!/+include("end")+/)/}end:{match:include("end")}contains: [
            {match: include("start")+include("Float") 0: "Error"} => Fail
            {match: /[^/+include("SplitSymbol")+/]/ 0: "Sele"}]}
        ]
        "SeleKeyValue":[
            {group:link,contains:[{match:include("start")+/(?:x|y|z)/+include("end") 0: "SeleSub"}{group:select,contains:[
                {group:link,contains:[{match:/ *=/, 0: "SeleSub"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Relative_Offset_Float"), 0: "Number"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                            {include: "SeleKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                    {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                            {include: "SeleKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:include("start")+/(?:dx|dy|dz)/+include("end") 0: "SeleSub"}{group:select,contains:[
                {group:link,contains:[{match:/ *=/, 0: "SeleSub"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                            {include: "SeleKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:include("start")+/(?:r|rm|rx|rxm|ry|rym)/+include("end") 0: "SeleSub"}{group:select,contains:[
                {group:link,contains:[{match:/ *=/, 0: "SeleSub"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Float")+include("end"), 0: "Number"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                            {include: "SeleKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:include("start")+/(?:l|lm|c)/+include("end") 0: "SeleSub"}{group:select,contains:[
                {group:link,contains:[{match:/ *=/, 0: "SeleSub"}{group:select,contains:[
                    {group:link,contains:[{match:include("start")+include("Int")+include("end"), 0: "Number"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                            {include: "SeleKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:include("start")+/(?:type)/+include("end") 0: "SeleSub"}{group:select,contains:[
                {group:link,contains:[{match:/ *=/, 0: "SeleSub"}{group:select,contains:[
                    {group:link,contains:[{match:/ *!/, 0: "Sele"}{group:select,contains:[
                        {group:link,contains:[{include:"ID_Entity"}{group:select,contains:[
                            {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                                {include: "SeleKeyValue"}
                            {include:"Error"}]}]}
                            {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                            {include:"stop"}]}]}
                        {include:"Error"}]}]}
                    {include:"Error"}]}]}
                    {group:link,contains:[{include:"ID_Entity"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                            {include: "SeleKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:include("start")+/(?:m)/+include("end") 0: "SeleSub"}{group:select,contains:[
                {group:link,contains:[{match:/ *=/, 0: "SeleSub"}{group:select,contains:[
                    {group:link,contains:[{match:/ *!/, 0: "Sele"}{group:select,contains:[
                        {group:link,contains:[{match:include("start")+/(?:1|2|0|a|s|c|survival|creative|default|adventure|spectator)/+include("end"), 0: "Opt"}{group:select,contains:[
                            {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                                {include: "SeleKeyValue"}
                            {include:"Error"}]}]}
                            {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                            {include:"stop"}]}]}
                        {include:"Error"}]}]}
                    {include:"Error"}]}]}
                    {group:link,contains:[{match:include("start")+/(?:1|2|0|a|s|c|survival|creative|default|adventure|spectator)/+include("end"), 0: "Opt"}{group:select,contains:[
                        {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                            {include: "SeleKeyValue"}
                        {include:"Error"}]}]}
                        {group:link,contains:[{match:/ *\]/, 0: "Sele"}{group:select,contains:[
                        {include:"stop"}]}]}
                    {include:"Error"}]}]}
                {include:"Error"}]}]}
            {include:"Error"}]}]}
            {group:link,contains:[{match:include("start")+/(?:tag)/+include("end") 0: "SeleSub"}{group:select,contains:[
                {group:link,contains:[{match:/ *=/, 0: "SeleSub"}{group:select,contains:[
                    {group:link,contains:[{match:/ *!/, 0: "Sele"}{group:select,contains:[
                        {group:link,contains:[{include:"BE_Quotation_String"}{group:select,contains:[
                            {group:link,contains:[{match:/ *,/, 0: "Sele"}{group:select,contains:[
                                {include: "SeleKeyValue"}
                            {include:"Error"}]}]}
